#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require __DIR__.'/vendor/autoload.php';
}

// Bootstrap Laravel and handle the command...
if (file_exists(__DIR__.'/bootstrap/app.php')) {
    $app = require_once __DIR__.'/bootstrap/app.php';
    if (is_object($app) && method_exists($app, 'handleCommand')) {
        $status = $app->handleCommand(new Symfony\Component\Console\Input\ArgvInput);
        exit($status);
    } elseif (is_object($app) && method_exists($app, 'make')) {
        $kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
        $status = $kernel->handle(
            $input = new Symfony\Component\Console\Input\ArgvInput,
            new Symfony\Component\Console\Output\ConsoleOutput
        );
        $kernel->terminate($input, $status);
        exit($status);
    }
}

echo "Laravel CLI initialized. If vendor is not yet installed, please run 'composer install'.\n";
